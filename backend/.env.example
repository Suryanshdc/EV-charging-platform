# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection string. When using the provided docker-compose.yml,
# this default value works out of the box.
DATABASE_URL="postgresql://evcharge:evcharge@localhost:5432/evcharge?schema=public"

# Port the Express + Socket.io server listens on
PORT=4000

# Secret used to sign JWTs — generate a long random string for production
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN="http://localhost:3000"

# Optional: Open Charge Map API key. The API works without a key at low
# request volume, but a free key (https://openchargemap.org/site/develop/api)
# raises your rate limit for the "nearby car stations" import.
OPEN_CHARGE_MAP_API_KEY=""
